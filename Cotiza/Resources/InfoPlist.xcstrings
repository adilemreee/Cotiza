{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Precia"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Cotiza"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia uses the camera to scan material receipts into your invoices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia usa la cámara para escanear recibos de materiales y agregarlos a tus facturas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia, malzeme fişlerini tarayıp faturalarına eklemek için kamerayı kullanır."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia uses the microphone so you can describe a job out loud and turn it into an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia usa el micrófono para que describas un trabajo en voz alta y lo convierta en cotización."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia, bir işi sesli anlatıp teklife dönüştürebilmen için mikrofonu kullanır."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia lets you pick a logo for your estimates and invoices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia te deja elegir un logo para tus cotizaciones y facturas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia, teklif ve faturaların için bir logo seçmene izin verir."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia transcribes what you say to build your estimate. Transcription happens on your device when possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia transcribe lo que dices para armar tu cotización. La transcripción se hace en tu teléfono cuando es posible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia, teklifini hazırlamak için söylediklerini yazıya döker. Mümkün olduğunda bu işlem telefonunda yapılır."
          }
        }
      }
    }
  },
  "version": "1.0"
}
