        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlerin, müşterilerin ve fiyatların özel iCloud'unda saklanır ve Apple Hesabınla giriş yaptığın her iPhone ve iPad'de görünür. Biz göremeyiz."
          }
