    "Prices, quantities and tasks become line items automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios, cantidades y trabajos se convierten en conceptos automáticamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar, miktarlar ve işler kendiliğinden kalemlere dönüşür."
          }
        }
      }
    },
    "Printed at the bottom of every document.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecen al final de cada documento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her belgenin altına basılır."
          }
        }
      }
    },
    "Printed on invoices, and on estimates that ask for a deposit. New estimates ask for this deposit; 0 means none.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en las facturas y en las cotizaciones que piden anticipo. Las cotizaciones nuevas piden este anticipo; 0 es sin anticipo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faturalara ve kapora isteyen tekliflere basılır. Yeni teklifler bu kaporayı ister; 0 kapora yok demektir."
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
