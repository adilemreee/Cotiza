    "Precia reads the items and prices on your phone. You choose which ones to add.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia lee los artículos y precios en tu teléfono. Tú eliges cuáles agregar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia kalemleri ve fiyatları telefonunda okur. Hangilerini ekleyeceğini sen seçersin."
          }
        }
      }
    },
    "Precia remembers your prices each time you send an estimate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia recuerda tus precios cada vez que envías una cotización."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia her teklif gönderdiğinde fiyatlarını hatırlar."
          }
        }
      }
    },
    "Precia reminds you when an estimate has waited %lld days for an answer and when an invoice is past due.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia te avisa cuando una cotización lleva %lld días sin respuesta y cuando una factura está vencida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia, bir teklif %lld gündür yanıt beklediğinde ve bir faturanın vadesi geçtiğinde sana hatırlatır."
          }
        }
      }
    },
    "Precia uses this to understand the jobs you describe.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia lo usa para entender los trabajos que describes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precia bunu anlattığın işleri anlamak için kullanır."
          }
        }
      }
    },
